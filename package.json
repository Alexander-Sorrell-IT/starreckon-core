{
  "name": "starreckon-core",
  "version": "0.27.0",
  "description": "Privacy-first developer wrapped: scans your local AI-coding session logs (Claude Code, Codex, Cowork), redacts secrets and masks paths BEFORE anything is written, keeps rolling monthly snapshots for longitudinal velocity, and renders your skill star live in the terminal. No network code on the scan path — and PROVE-IT.md shows you how to have the kernel confirm it rather than taking the claim on faith.",
  "type": "module",
  "bin": {
    "starreckon": "src/cli.mjs"
  },
  "main": "./src/cli.mjs",
  "files": [
    "src/",
    "spec/",
    "bin/",
    "tests/",
    "README.md",
    "PROVE-IT.md",
    "LICENSE",
    "!spec/identity.json",
    "!tests/fixtures/machines",
    "!tests/fixtures/machines/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexander-Sorrell-IT/starreckon-core.git"
  },
  "homepage": "https://github.com/Alexander-Sorrell-IT/starreckon-core#readme",
  "bugs": {
    "url": "https://github.com/Alexander-Sorrell-IT/starreckon-core/issues"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "developer",
    "wrapped",
    "claude-code",
    "privacy",
    "redaction",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "fast-check": "^4.9.0",
    "knip": "^6.32.2"
  }
}
